<view class="page page-content">
  <!-- 筛选标签 -->
  <view class="filter-bar">
    <scroll-view scroll-x class="filter-scroll">
      <view
        wx:for="{{filters}}"
        wx:key="index"
        class="filter-pill {{activeFilter === index ? 'filter-active' : ''}}"
        data-index="{{index}}"
        bindtap="onFilterTap"
      >{{item}}</view>
    </scroll-view>
  </view>

  <!-- 统计概览 - 加载态 -->
  <view class="overview-card glass-card" wx:if="{{summaryLoading}}">
    <view class="overview-row">
      <view class="overview-left">
        <view class="skeleton-line skeleton-line-label"></view>
        <view class="skeleton-line skeleton-line-value-lg"></view>
      </view>
      <view class="overview-right">
        <view class="skeleton-line skeleton-line-label"></view>
        <view class="skeleton-line skeleton-line-value-lg"></view>
      </view>
    </view>
  </view>
  <!-- 统计概览 - 数据态（始终展示，含零值） -->
  <view class="overview-card glass-card" wx:elif="{{!summaryLoading}}">
    <view class="overview-row">
      <view class="overview-left">
        <text class="overview-label">{{summaryLabel}}</text>
        <text class="overview-value font-mono">{{summaryCount}}<text class="overview-unit"> 次</text></text>
      </view>
      <view class="overview-right">
        <text class="overview-label">充电量 / 费用</text>
        <text class="overview-value font-mono">{{summaryKwh}}<text class="overview-unit"> kWh</text> · ¥{{summaryCost}}</text>
      </view>
    </view>
  </view>

  <!-- 记录列表 - 加载态 -->
  <view class="record-list" wx:if="{{listLoading}}">
    <view class="skeleton-record-group" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton-line skeleton-line-date"></view>
      <view class="skeleton-card-list">
        <view class="skeleton-record-item glass-card" wx:for="{{[1,2]}}" wx:for-item="card" wx:key="*this">
          <view class="skeleton-record-left">
            <view class="skeleton-circle skeleton-circle-sm"></view>
            <view class="skeleton-lines">
              <view class="skeleton-line skeleton-line-long"></view>
              <view class="skeleton-line skeleton-line-short"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <!-- 记录列表 - 数据态 -->
  <view class="record-list" wx:elif="{{groupedRecords.length}}">
    <block wx:for="{{groupedRecords}}" wx:key="label">
      <text class="date-label">{{item.label}}</text>
      <view class="record-group">
        <record-card
          wx:for="{{item.records}}"
          wx:for-item="record"
          wx:key="_id"
          record="{{record}}"
        />
      </view>
    </block>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{!listLoading && hasMore}}" bindtap="onLoadMore">
    <text class="load-more-text">加载更多</text>
  </view>

  <!-- 空态 -->
  <view class="empty-state" wx:if="{{!loading && !listLoading && groupedRecords.length === 0}}">
    <text class="empty-icon">🔋</text>
    <text class="empty-text">暂无充电记录</text>
    <text class="empty-hint">点击底部录入按钮添加第一条记录</text>
  </view>
</view>