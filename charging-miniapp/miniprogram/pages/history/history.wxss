.page {
  background: var(--app-bg, #ECFEFF);
  min-height: 100vh;
}

.filter-bar {
  background: #fff;
  padding: 16rpx 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-pill {
  display: inline-block;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 100rpx;
  margin-right: 16rpx;
  color: #64748B;
  background: #f1f5f9;
}

.filter-active {
  background: #0891B2;
  color: #fff;
}

.overview-card {
  margin: 32rpx;
}

.overview-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.overview-label {
  font-size: 26rpx;
  color: #64748B;
  display: block;
}

.overview-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--app-text, #164E63);
  margin-top: 8rpx;
  display: block;
}

.overview-unit {
  font-size: 26rpx;
  font-weight: 500;
}

.record-list {
  padding: 0 32rpx;
}

.date-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #64748B;
  padding: 16rpx 0;
  display: block;
}

.record-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.load-more {
  padding: 48rpx;
  text-align: center;
}

.load-more-text {
  font-size: 28rpx;
  color: #0891B2;
  font-weight: 500;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #64748B;
  font-weight: 500;
}

.empty-hint {
  font-size: 26rpx;
  color: #94A3B8;
  margin-top: 12rpx;
}

/* ========== Skeleton 骨架屏 ========== */
.skeleton-line {
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

.skeleton-line-label {
  width: 120rpx;
  height: 24rpx;
  margin-bottom: 12rpx;
}

.skeleton-line-value-lg {
  width: 200rpx;
  height: 36rpx;
}

.skeleton-line-date {
  width: 160rpx;
  height: 24rpx;
  margin-bottom: 16rpx;
}

.skeleton-line-long {
  width: 200rpx;
  height: 28rpx;
  margin-bottom: 8rpx;
}

.skeleton-line-short {
  width: 140rpx;
  height: 20rpx;
}

.skeleton-circle {
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}

.skeleton-circle-sm {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.skeleton-lines {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.skeleton-record-group {
  margin-bottom: 32rpx;
}

.skeleton-card-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.skeleton-record-item {
  padding: 32rpx;
}

.skeleton-record-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

@keyframes skeleton-pulse {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
