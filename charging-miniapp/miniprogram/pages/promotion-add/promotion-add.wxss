.page {
  padding: 32rpx;
  background: var(--app-bg, #ECFEFF);
}

.page-content {
  padding-bottom: 200rpx;
}

/* ========== 平台选择网格 ========== */
.platform-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.platform-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  gap: 8rpx;
  border: 4rpx solid #e2e8f0;
  border-radius: 20rpx;
  background: #fff;
  transition: var(--transition);
}

.platform-card:active {
  transform: scale(0.96);
}

.platform-selected {
  border-width: 4rpx;
  border-style: solid;
}

.platform-emoji {
  font-size: 36rpx;
  color: #94A3B8;
}

.platform-name {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--app-text, #164E63);
}

/* ========== 时间选择行 ========== */
.time-row {
  display: flex;
  gap: 24rpx;
}

.time-field {
  flex: 1;
}

.time-label {
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 12rpx;
  display: block;
}

.picker-field {
  display: flex;
  align-items: center;
  color: var(--app-text, #164E63);
}

/* ========== 标签选择 ========== */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-pill {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 999rpx;
  border: 4rpx solid #e2e8f0;
  color: #64748B;
  background: #fff;
  transition: var(--transition);
}

.tag-pill:active {
  transform: scale(0.95);
}

.tag-selected {
  border-width: 4rpx;
  border-style: solid;
}

/* ========== 输入框前缀 ========== */
.input-with-prefix {
  position: relative;
}

.input-prefix {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  color: #94A3B8;
  z-index: 1;
}

.input-with-left-pad {
  padding-left: 56rpx !important;
}

/* ========== 表单标签行 ========== */
.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-hint {
  font-size: 22rpx;
  color: #94A3B8;
}

/* ========== 必填/选填标签 ========== */
.required-tag {
  font-size: 20rpx;
  color: #EF4444;
  background: rgba(239, 68, 68, 0.08);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.optional-tag {
  font-size: 20rpx;
  color: #94A3B8;
  background: rgba(148, 163, 184, 0.08);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

/* ========== 文本域 ========== */
.textarea-field {
  width: 100%;
  padding: 24rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--app-text, #164E63);
  min-height: 180rpx;
}

/* ========== 提交区域 ========== */
.submit-area {
  margin-top: 48rpx;
  padding-bottom: 32rpx;
}

/* ========== 其他平台输入 ========== */
.other-platform-input {
  margin-top: 20rpx;
}

/* ========== 领取步骤示例 ========== */
.steps-hint {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(148, 163, 184, 0.06);
  border-radius: 12rpx;
}

.steps-hint-row {
  font-size: 24rpx;
  color: #94A3B8;
  line-height: 1.8;
}