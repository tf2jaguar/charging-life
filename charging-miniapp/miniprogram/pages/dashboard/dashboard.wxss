.page {
  min-height: 100vh;
  background: var(--app-bg, #ECFEFF);
  padding-bottom: 180rpx;
}

.status-bar {
  background: var(--primary, #0891B2);
}

/* Primary头部 */
.header-primary {
  background: var(--primary, #0891B2);
  color: #fff;
  padding: 32rpx 32rpx 64rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.greeting-area {
  display: flex;
  flex-direction: column;
}

.greeting-text {
  font-size: 26rpx;
  opacity: 0.8;
}

.user-name {
  font-size: 40rpx;
  font-weight: 600;
}

.header-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 36rpx;
}

/* 车辆卡 */
.vehicle-card {
  margin-top: 16rpx;
  position: relative;
}

.vehicle-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.vehicle-switch-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #94A3B8;
}

.vehicle-icon {
  width: 96rpx;
  height: 96rpx;
  background: rgba(8, 145, 178, 0.1);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.vehicle-icon-img {
  width: 52rpx;
  height: 52rpx;
}

.vehicle-info {
  flex: 1;
  min-width: 0;
}

.vehicle-name {
  font-weight: 600;
  font-size: 30rpx;
  color: var(--app-text, #164E63);
  display: block;
}

.vehicle-trim {
  font-size: 26rpx;
  color: #64748B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.vehicle-charge-info {
  text-align: right;
  flex-shrink: 0;
}

.vehicle-charge-kwh {
  display: flex;
  align-items: center;
  gap: 6rpx;
  justify-content: flex-end;
}

.vehicle-charge-icon {
  font-size: 24rpx;
  color: #22C55E;
}

.vehicle-charge-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #164E63;
}

.vehicle-charge-time {
  font-size: 24rpx;
  color: #94A3B8;
  display: block;
  margin-top: 4rpx;
}

/* 快捷入口 */
.quick-entry {
  margin: -32rpx 32rpx 0;
  position: relative;
  z-index: 10;
  padding: 32rpx;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.entry-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.entry-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.entry-icon-cta { 
  background: rgba(106, 245, 141, 0.193);
}

.entry-icon-primary {
  background: rgba(8, 145, 178, 0.1);
}

.entry-icon-amber {
  background: rgba(245, 159, 11, 0.258);
}

.entry-icon-violet {
  background: rgba(138, 92, 246, 0.263);
}

.entry-icon-rose {
  background: rgba(244, 63, 94, 0.15);
}

.entry-icon-emoji {
  font-size: 40rpx;
}

.entry-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--app-text, #164E63);
}

/* 月份导航栏 */
.month-nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 0 0 24rpx;
}

.month-nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(8, 145, 178, 0.08);
  transition: background 0.2s;
}

.month-nav-btn:active {
  background: rgba(8, 145, 178, 0.18);
}

.month-nav-arrow {
  font-size: 36rpx;
  color: #0891B2;
  font-weight: 400;
  line-height: 1;
}

.month-nav-info {
  text-align: center;
  min-width: 200rpx;
}

.month-nav-label {
  font-size: 34rpx;
  font-weight: 600;
  color: #164E63;
}

/* 概览 */
.overview-section {
  padding: 16rpx;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

/* 日历懒加载触发区 */
.calendar-trigger {
  height: 2rpx;
  margin: 0 32rpx;
}

/* 日历 */
.calendar-section {
  padding: 0 32rpx;
  margin-top: 16rpx;
}

.calendar-card {
  padding: 0;
  overflow: hidden;
}

/* 最近充电 */
.recent-section {
  padding: 32rpx;
  margin-top: 16rpx;
}

.recent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.recent-more {
  font-size: 28rpx;
  color: var(--primary, #0891B2);
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.recent-item {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recent-item-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.recent-item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recent-item-icon .flashlight-icon {
  width: 44rpx;
  height: 44rpx;
}

.icon-fast {
  background: rgba(8, 145, 178, 0.1);
  color: #0891B2;
}

.icon-slow {
  background: rgba(16, 185, 129, 0.1);
  color: #10B981;
}

.icon-super {
  background: rgba(139, 92, 246, 0.1);
  color: #8B5CF6;
}

.recent-item-info {
  display: flex;
  flex-direction: column;
}

.recent-item-name {
  font-weight: 500;
  font-size: 30rpx;
  color: var(--app-text, #164E63);
}

.recent-item-time {
  font-size: 24rpx;
  color: #94A3B8;
}

.recent-item-right {
  text-align: right;
}

.recent-item-kwh {
  font-weight: 600;
  font-size: 30rpx;
  color: var(--app-text, #164E63);
  display: block;
}

.recent-item-cost {
  font-size: 24rpx;
  color: #94A3B8;
}

/* 车辆选择弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--app-text, #164E63);
}

.picker-close {
  font-size: 36rpx;
  color: #94A3B8;
  padding: 0 8rpx;
}

.picker-list {
  padding: 16rpx 0;
  overflow-y: auto;
  flex: 1;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
}

.picker-item-active {
  background: rgba(8, 145, 178, 0.06);
}

.picker-item-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(8, 145, 178, 0.1);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.picker-item-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.picker-item-info {
  flex: 1;
  min-width: 0;
}

.picker-item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--app-text, #164E63);
  display: block;
}

.picker-item-trim {
  font-size: 24rpx;
  color: #94A3B8;
  display: block;
  margin-top: 2rpx;
}

.picker-item-check {
  font-size: 32rpx;
  color: #0891B2;
  font-weight: 600;
  flex-shrink: 0;
}

/* ========== Skeleton 骨架屏 ========== */
.skeleton-line {
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s ease-in-out infinite;
  border-radius: 8rpx;
  height: 24rpx;
}

.skeleton-line-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.skeleton-line-value {
  width: 80rpx;
  height: 32rpx;
  margin-bottom: 12rpx;
}

.skeleton-line-label {
  width: 120rpx;
  height: 20rpx;
}

.skeleton-line-long {
  width: 200rpx;
  height: 28rpx;
  margin-bottom: 8rpx;
}

.skeleton-line-short {
  width: 140rpx;
  height: 20rpx;
}

.skeleton-line-month {
  width: 160rpx;
  height: 28rpx;
}

.skeleton-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}

.skeleton-circle-sm {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
}

.skeleton-lines {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.skeleton-card {
  background: rgba(255, 255, 255, 0.85);
  border-radius: var(--card-radius-sm);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.vehicle-card-skeleton .vehicle-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.skeleton-recent .recent-item-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.skeleton-calendar {
  padding: 32rpx;
}

.skeleton-calendar-header {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.skeleton-calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 16rpx;
}

.skeleton-cell {
  height: 64rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
