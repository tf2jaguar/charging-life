.page {
  padding: 32rpx;
  background: var(--app-bg, #ECFEFF);
}

.page-content {
  padding-bottom: 200rpx;
}

/* ========== 加载骨架 ========== */
.loading-wrap {
  padding: 0;
}

.skeleton-banner {
  height: 360rpx;
  background: linear-gradient(135deg, #fde68a, #fdba74, #fda4af);
  border-radius: var(--card-radius-sm);
  opacity: 0.5;
  animation: pulse 1.5s ease-in-out infinite;
}

.skeleton-card {
  height: 200rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: var(--card-radius-sm);
  margin-top: 24rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 0.3; }
}

/* ========== 顶部横幅 ========== */
.banner {
  overflow: hidden;
  border-radius: var(--card-radius-sm);
  margin-bottom: 24rpx;
}

.banner-bg {
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.banner-deco {
  position: absolute;
  inset: 0;
  opacity: 0.1;
}

.deco-circle {
  position: absolute;
  border: 4rpx solid #fff;
  border-radius: 50%;
}

.deco-circle-1 {
  top: 32rpx;
  left: 32rpx;
  width: 160rpx;
  height: 160rpx;
}

.deco-circle-2 {
  bottom: 48rpx;
  right: 48rpx;
  width: 128rpx;
  height: 128rpx;
}

.deco-circle-3 {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 256rpx;
  height: 256rpx;
}

.banner-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.banner-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.banner-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* ========== 信息卡片 ========== */
.publish-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #64748B;
}

.publish-name {
  font-weight: 600;
  color: #334155;
}

.publish-time {
  color: #94A3B8;
}

.publish-action {
  color: #0891B2;
  font-weight: 500;
}

.info-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.card-icon {
  font-size: 28rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--app-text, #164E63);
}

/* ========== 信息列表 ========== */
.info-list {
  /* container */
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.info-row-last {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #94A3B8;
}

.info-value {
  font-size: 26rpx;
  color: var(--app-text, #164E63);
}

.info-value-bold {
  font-weight: 500;
}

.info-value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.platform-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.info-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--cta, #22C55E);
  font-family: 'Menlo', 'Courier New', monospace;
  font-variant-numeric: tabular-nums;
}

.info-date {
  font-size: 22rpx;
  color: #475569;
  font-family: 'Menlo', 'Courier New', monospace;
  font-variant-numeric: tabular-nums;
}

.tag-badge {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid;
}

/* ========== 领取步骤 ========== */
.steps-list {
  /* container */
}

.step-item {
  display: flex;
  gap: 24rpx;
}

.step-left {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F59E0B;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.step-num-last {
  background: var(--cta, #22C55E);
}

.step-line {
  width: 4rpx;
  flex: 1;
  background: #FDE68A;
  margin-top: 8rpx;
  min-height: 32rpx;
}

.step-content {
  padding-bottom: 32rpx;
  flex: 1;
}

.step-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--app-text, #164E63);
  line-height: 1.5;
}

/* ========== 跳转链接 ========== */
.link-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: rgba(8, 145, 178, 0.05);
  border-radius: 16rpx;
  border: 2rpx solid rgba(8, 145, 178, 0.2);
}

.link-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.link-icon {
  font-size: 32rpx;
  color: var(--primary, #0891B2);
}

.link-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary, #0891B2);
}

.link-arrow {
  font-size: 32rpx;
  color: var(--primary, #0891B2);
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  border-top: 2rpx solid #f1f5f9;
  z-index: 50;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-delete {
  height: 96rpx;
  padding: 0 48rpx;
  border: 4rpx solid rgba(244, 63, 94, 0.2);
  color: #F43F5E;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-edit {
  height: 96rpx;
  padding: 0 48rpx;
  border: 4rpx solid rgba(8, 145, 178, 0.2);
  color: #0891B2;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-go {
  flex: 1;
  height: 96rpx;
  background: var(--cta, #22C55E);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(34, 197, 94, 0.2);
}

.btn-go-disabled {
  background: #CBD5E1;
  color: #94A3B8;
  box-shadow: none;
}

.btn-cancel {
  flex: 1;
  height: 96rpx;
  border: 2rpx solid #e2e8f0;
  color: #475569;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-save {
  flex: 1;
  height: 96rpx;
  background: var(--cta, #22C55E);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(34, 197, 94, 0.2);
}

/* ========== 删除确认弹窗 ========== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.drawer {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.drawer-handle {
  width: 80rpx;
  height: 8rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--app-text, #164E63);
  display: block;
  margin-bottom: 16rpx;
}

.drawer-desc {
  font-size: 26rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 48rpx;
}

.drawer-actions {
  display: flex;
  gap: 24rpx;
}

.drawer-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.drawer-btn-cancel {
  border: 2rpx solid #e2e8f0;
  color: #475569;
}

.drawer-btn-delete {
  background: #F43F5E;
  color: #fff;
}

/* ========== 编辑模式样式（复用add页） ========== */
.platform-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.platform-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  gap: 8rpx;
  border: 4rpx solid #e2e8f0;
  border-radius: 20rpx;
  background: #fff;
}

.platform-card:active {
  transform: scale(0.96);
}

.platform-selected {
  border-width: 4rpx;
  border-style: solid;
}

.platform-emoji {
  font-size: 36rpx;
  color: #94A3B8;
}

.platform-name {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--app-text, #164E63);
}

.time-row {
  display: flex;
  gap: 24rpx;
}

.time-field {
  flex: 1;
}

.time-label {
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 12rpx;
  display: block;
}

.picker-field {
  display: flex;
  align-items: center;
  color: var(--app-text, #164E63);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-pill {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 999rpx;
  border: 4rpx solid #e2e8f0;
  color: #64748B;
  background: #fff;
}

.tag-pill:active {
  transform: scale(0.95);
}

.tag-selected {
  border-width: 4rpx;
  border-style: solid;
}

.input-with-prefix {
  position: relative;
}

.input-prefix {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  color: #94A3B8;
  z-index: 1;
}

.input-with-left-pad {
  padding-left: 56rpx !important;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-hint {
  font-size: 22rpx;
  color: #94A3B8;
}

.textarea-field {
  width: 100%;
  padding: 24rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--app-text, #164E63);
  min-height: 180rpx;
}

/* ========== 领取步骤示例 ========== */
.steps-hint {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(148, 163, 184, 0.06);
  border-radius: 12rpx;
}

.steps-hint-row {
  font-size: 24rpx;
  color: #94A3B8;
  line-height: 1.8;
}

/* ========== 其他平台输入 ========== */
.other-platform-input {
  margin-top: 20rpx;
}

/* ========== 状态标签 ========== */
.status-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
}

/* ========== 状态选择器 ========== */
.status-picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
}

.picker-arrow {
  font-size: 32rpx;
  color: #94A3B8;
}