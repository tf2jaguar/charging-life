.page {
  padding: 32rpx;
  background: var(--app-bg, #ECFEFF);
}

.page-content {
  padding-bottom: 200rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-icon {
  font-size: 28rpx;
}

.picker-field {
  display: flex;
  align-items: center;
  color: var(--app-text, #164E63);
}

.input-disabled {
  opacity: 0.5;
}

.placeholder {
  color: #cbd5e1;
}

.hint-text {
  font-size: 22rpx;
  color: #cbd5e1;
  margin-top: 16rpx;
  display: block;
}

.default-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.default-text {
  font-size: 30rpx;
  color: var(--app-text, #164E63);
}

.submit-area {
  margin-top: 48rpx;
}

.feedback-box {
  margin-top: 32rpx;
  padding: 32rpx;
  background: rgba(8, 145, 178, 0.05);
  border-radius: 20rpx;
}

.feedback-text {
  font-size: 28rpx;
  color: #64748B;
}

.feedback-link {
  color: #0891B2;
  font-weight: 500;
}

/* 型号信息标签 */
.model-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.model-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.model-tag-energy {
  background: rgba(8, 145, 178, 0.1);
  color: #0891B2;
}

.model-tag-type {
  background: rgba(139, 92, 246, 0.1);
  color: #8B5CF6;
}

.model-price {
  font-size: 22rpx;
  color: #94A3B8;
}

/* Skeleton */
.skeleton-line {
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

.skeleton-line-picker {
  width: 160rpx;
  height: 28rpx;
}

@keyframes skeleton-pulse {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}